# ==========================================================
#  คัดลอกค่าเหล่านี้ไปใส่ที่ Vercel
#  Project → Settings → Environment Variables → Add
#  (ห้าม commit ไฟล์ที่มีค่าจริงขึ้น GitHub เด็ดขาด)
# ==========================================================

# ---------- 0. เว็บ & หลังบ้าน (Vercel) ----------
# โดเมนจริงของเว็บ (ไม่ต้องมี / ปิดท้าย) — ถ้าไม่ใส่ ระบบใช้โดเมน Vercel อัตโนมัติ
SITE_URL=
# GitHub OAuth สำหรับล็อกอินหลังบ้าน /admin
# สร้างที่ GitHub → Settings → Developer settings → OAuth Apps → New
#   Homepage URL:            https://your-app.vercel.app
#   Authorization callback:  https://your-app.vercel.app/api/callback
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# ---------- 1. Lark: แจ้งเตือนเข้ากลุ่ม (จำเป็น) ----------
# สร้างจาก: เปิดกลุ่ม Lark → Settings → Bots → Add Bot → Custom Bot → คัดลอก Webhook URL
LARK_WEBHOOK_URL=

# ---------- 2. Lark App: ใช้ส่ง "รูปสลิป" เข้ากลุ่ม (จำเป็นถ้าจะรับโอน) ----------
# สร้างที่ open.larksuite.com → Developer Console → Create Custom App
# เปิดสิทธิ์ (Permissions): im:resource  แล้ว Publish เวอร์ชัน
# ถ้าไม่ใส่ 2 ค่านี้ ออเดอร์ยังเข้ากลุ่มปกติ แต่จะไม่มีรูปสลิปแนบมา
LARK_APP_ID=
LARK_APP_SECRET=
# ถ้าใช้ Feishu (จีน) เปลี่ยนเป็น https://open.feishu.cn
LARK_BASE_URL=https://open.larksuite.com

# ---------- 3. Google Sheet: เก็บข้อมูลออเดอร์ ----------
# ทำตามขั้นตอนในไฟล์ google-apps-script.gs แล้วเอา URL ที่ได้มาใส่
SHEET_WEBHOOK_URL=
# ตั้งรหัสลับอะไรก็ได้ ต้องตรงกับที่ตั้งในสคริปต์ Apps Script
SHEET_SECRET=

# ---------- 4. Pay Solutions: บัตรเครดิต ----------
# โหมด link = ใช้ Payment Link ที่มีอยู่ (ใช้ได้เลย ไม่ต้องขออะไรเพิ่ม)
# โหมด api  = เชื่อมต่อเต็มรูปแบบ ระบบรู้ผลการชำระเงินอัตโนมัติ
#             ต้องขอ "เอกสารเชื่อมต่อ" จาก Pay Solutions ก่อน
PAYSO_MODE=link
PAYSO_PAY_LINK=https://pay.sn/relifesolutions

# ---- ใส่เฉพาะเมื่อ PAYSO_MODE=api ----
PAYSO_MERCHANT_ID=
PAYSO_SECRET_KEY=
PAYSO_ENDPOINT=
PAYSO_HASH_ALGO=md5
PAYSO_SUCCESS_CODES=CO,00,000,SUCCESS,PAID
